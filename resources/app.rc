#include <windows.h>

// Иконка приложения
IDI_ICON1 ICON "app.ico"

// Информация о версии (для свойств файла)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // русская локаль + Unicode
        BEGIN
            VALUE "CompanyName",      "DXStreem"
            VALUE "FileDescription",  "SnapCopy — менеджер буфера обмена"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SnapCopy"
            VALUE "LegalCopyright",   "© 2026 DXStreem"
            VALUE "OriginalFilename", "SnapCopy.exe"
            VALUE "ProductName",      "SnapCopy"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END